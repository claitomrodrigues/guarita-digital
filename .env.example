APP_NAME="Guarita Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=guarita_digital
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

ADMIN_NAME="Administrador"
ADMIN_MATRICULA=admin
ADMIN_EMAIL=admin@guarita.local
ADMIN_PASSWORD="Guarita@2026"

# Reconhecimento local da placa. No Windows/Laragon, use o Python da .venv.
PYTHON_PATH="C:/laragon/www/guarita-digital/python/.venv/Scripts/python.exe"
PLACA_SCRIPT="C:/laragon/www/guarita-digital/python/reconhecer_imagem.py"
OCR_TIMEOUT_SECONDS=180
OCR_IDLE_TIMEOUT_SECONDS=90
MAX_CAPTURE_KB=10240
